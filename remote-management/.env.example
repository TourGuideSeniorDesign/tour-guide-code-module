# Public IP or hostname Caddy should bind to and request a cert for.
# Let's Encrypt's IP-address cert profile requires this be reachable on
# ports 80/443 from the public internet.
PUBLIC_HOST=139.147.176.3

# HTTP Basic Auth credentials for the admin UI and API.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Where the robot's remote_logger forwards logs. Same credentials as above.
REMOTE_LOG_URL=https://139.147.176.3

# SQLite file path (absolute or relative to remote-management/).
DATABASE_PATH=./remote-management.db
